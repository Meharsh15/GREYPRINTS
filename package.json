{
  "name": "greyprints-android",
  "version": "1.0.0",
  "private": true,
  "description": "GREYPRINTS Android app built from the existing GreyStudio print catalogue",
  "scripts": {
    "build": "node scripts/prepare-web.mjs && esbuild src/native-app.js --bundle --format=esm --outfile=www/native-app.bundle.js --platform=browser --target=es2017",
    "android:add": "npm run build && cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "esbuild": "^0.27.0"
  }
}
